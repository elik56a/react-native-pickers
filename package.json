{
  "name": "@elik56a/react-native-pickers",
  "version": "0.4.1",
  "description": "Beautiful, fully customizable pickers for React Native in pure JS: wheel, time, date (calendar + wheel + range), select and emoji. No native code, works with Expo and React Native Web.",
  "license": "MIT",
  "author": "Eliyahu Kriel <elik56a@gmail.com>",
  "homepage": "https://elik56a.github.io/react-native-pickers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elik56a/react-native-pickers.git"
  },
  "bugs": {
    "url": "https://github.com/elik56a/react-native-pickers/issues"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react-native",
    "picker",
    "wheel-picker",
    "date-picker",
    "time-picker",
    "calendar",
    "range-picker",
    "select",
    "dropdown",
    "emoji-picker",
    "expo",
    "react-native-web",
    "bottom-sheet",
    "datepicker",
    "timepicker",
    "datetime-picker",
    "calendar-picker",
    "date-range-picker",
    "dropdown-picker",
    "multi-select",
    "emoji-keyboard",
    "duration-picker",
    "ios-picker",
    "react-native-component",
    "typescript"
  ],
  "scripts": {
    "start": "pnpm --filter pickers-example start",
    "web": "pnpm --filter pickers-example web",
    "ios": "pnpm --filter pickers-example ios",
    "android": "pnpm --filter pickers-example android",
    "docs": "pnpm --filter pickers-website start",
    "docs:build": "pnpm --filter pickers-website build",
    "lint": "biome check .",
    "format": "node scripts/expand-returned-objects.js && biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "gen:emoji": "node scripts/build-emoji-data.js",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.8",
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "emojibase-data": "^16.0.3",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "react": "19.3.0",
    "react-native": "^0.88.0",
    "test-renderer": "^1.3.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
