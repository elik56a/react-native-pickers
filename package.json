{
  "name": "@elik56a/react-native-pickers",
  "version": "0.28.0",
  "description": "Fully customizable React Native pickers with zero native code: wheel, time, duration, date (calendar, range, wheel), month, week strip, date-time, select (with server search), country (flags and dialing codes), phone number, time zone, segmented control, emoji and color, a slider (single or range), a star rating, an OTP code input, plus bottom sheets, action sheets, menus and form fields. Native iOS, Material and web designs. No native code, works with Expo and React Native Web.",
  "license": "MIT",
  "author": "Eliyahu Kriel <elik56a@gmail.com>",
  "homepage": "https://react-native-pickers.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elik56a/react-native-pickers.git"
  },
  "bugs": {
    "url": "https://github.com/elik56a/react-native-pickers/issues"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*/index.d.ts",
      "react-native": "./src/*/index.ts",
      "default": "./lib/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/__tests__",
    "README.md",
    "LICENSE",
    "llms-full.txt"
  ],
  "sideEffects": false,
  "keywords": [
    "react-native",
    "picker",
    "wheel-picker",
    "date-picker",
    "time-picker",
    "calendar",
    "range-picker",
    "select",
    "dropdown",
    "inline-picker",
    "emoji-picker",
    "country-picker",
    "country-code-picker",
    "phone-code",
    "phone-input",
    "phone-number-input",
    "timezone-picker",
    "time-zone-picker",
    "expo",
    "react-native-web",
    "bottom-sheet",
    "action-sheet",
    "menu",
    "context-menu",
    "dropdown-menu",
    "modal",
    "datepicker",
    "timepicker",
    "datetime-picker",
    "calendar-picker",
    "date-range-picker",
    "dropdown-picker",
    "multi-select",
    "emoji-keyboard",
    "color-picker",
    "slider",
    "range-slider",
    "otp-input",
    "otp",
    "rating",
    "star-rating",
    "verification-code",
    "colour-picker",
    "hex-color-picker",
    "duration-picker",
    "timer-picker",
    "month-picker",
    "month-year-picker",
    "week-calendar",
    "week-strip",
    "ios-picker",
    "react-native-component",
    "keyboard-accessible",
    "pure-js",
    "no-native-code",
    "material-design",
    "material-date-picker",
    "segmented-control",
    "chips",
    "autocomplete",
    "combobox",
    "form-field",
    "react-hook-form",
    "typescript"
  ],
  "scripts": {
    "start": "pnpm --filter pickers-example start",
    "web": "pnpm --filter pickers-example web",
    "ios": "pnpm --filter pickers-example ios",
    "android": "pnpm --filter pickers-example android",
    "docs": "pnpm --filter pickers-website start",
    "docs:build": "pnpm --filter pickers-website build",
    "lint": "biome check .",
    "format": "node scripts/expand-returned-objects.js && biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "build:llms": "pnpm docs:build && cp website/build/llms-full.txt llms-full.txt",
    "gen:emoji": "node scripts/build-emoji-data.js",
    "gen:countries": "node scripts/build-country-data.js",
    "gen:timezones": "node scripts/build-timezone-data.js",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:llms"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.8",
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "countries-list": "^3.4.1",
    "emojibase-data": "^18.0.0",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "react": "19.3.1",
    "react-native": "^0.88.1",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
