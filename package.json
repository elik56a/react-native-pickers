{
  "name": "@elik56a/react-native-pickers",
  "version": "0.1.0",
  "description": "Beautiful, fully customizable pickers for React Native in pure JS: wheel, time, date (calendar + wheel + range), select and emoji. No native code, works with Expo and React Native Web.",
  "license": "MIT",
  "author": "Eliyahu Kriel <elik56a@gmail.com>",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react-native",
    "picker",
    "wheel-picker",
    "date-picker",
    "time-picker",
    "calendar",
    "range-picker",
    "select",
    "dropdown",
    "emoji-picker",
    "expo",
    "react-native-web",
    "bottom-sheet"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "jest",
    "gen:emoji": "node scripts/build-emoji-data.js",
    "example:web": "node example/web/build.js App.tsx",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "example": "pnpm --filter pickers-example start"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "emojibase-data": "^16.0.3",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.6",
    "react-native-web": "^0.21.4",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.2"
}
