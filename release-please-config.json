{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "8219d652c55d0ab33ad46475de3c98be3b598211",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore(release): v${version}",
  "pull-request-header": ":rocket: Merging this PR publishes the release below to npm, tags it, creates the GitHub release and redeploys the docs.",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@elik56a/react-native-pickers",
      "bump-minor-pre-major": true,
      "exclude-paths": ["website", "example", ".github", "lint"],
      "changelog-sections": [
        { "type": "feat", "section": "✨ Features" },
        { "type": "fix", "section": "🐛 Bug Fixes" },
        { "type": "perf", "section": "⚡ Performance" },
        { "type": "revert", "section": "⏪ Reverts" },
        { "type": "docs", "section": "📚 Documentation", "hidden": true },
        { "type": "refactor", "section": "♻️ Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true }
      ]
    }
  }
}
