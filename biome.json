{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "plugins": ["./lint/expand-returned-objects.grit"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!src/emoji/data.ts", "!website/static", "!**/*.md", "!**/*.mdx", "!**/*.yaml", "!**/*.yml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["react", "react/**", "react-native", "react-native/**"],
              ":BLANK_LINE:",
              [":NODE:", ":BUN:", ":PACKAGE_WITH_PROTOCOL:", ":PACKAGE:", "!@elik56a/**"],
              ":BLANK_LINE:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": { "level": "on", "options": { "skip": ["PickerText"] } }
          }
        }
      }
    },
    {
      "includes": ["website/src/css/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
